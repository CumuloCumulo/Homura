{
  "name": "homura",
  "version": "0.1.0",
  "description": "Next-gen AI Browser Automation Agent - Declarative RPA with AI-powered decision making",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:sdk && tsc && vite build",
    "build:extension": "tsc && vite build",
    "build:sdk": "cd packages/sdk && tsc",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:sdk": "cd packages/sdk && tsc --noEmit",
    "check:duplicates": "bash scripts/check-type-conflicts.sh",
    "check:imports": "bash scripts/check-import-paths.sh",
    "check:all": "npm run typecheck && npm run check:duplicates && npm run check:imports",
    "quick-check": "bash scripts/quick-check.sh",
    "lint": "eslint 'src/**/*.ts' 'src/**/*.tsx' 'packages/sdk/src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' 'src/**/*.tsx' 'packages/sdk/src/**/*.ts' --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepare": "husky install",
    "new:function": "bash scripts/new-file.sh function",
    "new:test": "bash scripts/new-file.sh test",
    "new:component": "bash scripts/new-file.sh component"
  },
  "dependencies": {
    "@homura/sdk": "file:./packages/sdk",
    "framer-motion": "^12.29.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "webextension-polyfill": "^0.10.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/webextension-polyfill": "^0.10.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^4.1.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^4.1.0"
  }
}
