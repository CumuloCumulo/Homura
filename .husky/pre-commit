#!/bin/sh

###############################################################################
# Pre-commit Hook
#
# 自动执行检查，确保代码质量
###############################################################################

set -e

echo "🔍 运行 pre-commit 检查..."

# 颜色定义
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 1. TypeScript 类型检查
echo -e "\n${YELLOW}1️⃣ TypeScript 类型检查...${NC}"
if ! npm run typecheck --silent; then
  echo -e "${RED}❌ TypeScript 类型检查失败${NC}"
  echo -e "${YELLOW}运行 'npm run typecheck' 查看详情${NC}"
  exit 1
fi
echo -e "${GREEN}✅ TypeScript 类型检查通过${NC}"

# 2. 类型冲突检查
echo -e "\n${YELLOW}2️⃣ 检查类型冲突...${NC}"
if ! npm run check:duplicates --silent 2>/dev/null; then
  echo -e "${RED}❌ 发现类型冲突${NC}"
  echo -e "${YELLOW}运行 'npm run check:duplicates' 查看详情${NC}"
  exit 1
fi
echo -e "${GREEN}✅ 无类型冲突${NC}"

# 3. 导入路径检查
echo -e "\n${YELLOW}3️⃣ 检查导入路径...${NC}"
if ! npm run check:imports --silent 2>/dev/null; then
  echo -e "${RED}❌ 发现错误的导入路径${NC}"
  echo -e "${YELLOW}运行 'npm run check:imports' 查看详情${NC}"
  exit 1
fi
echo -e "${GREEN}✅ 导入路径正确${NC}"

# 4. ESLint 检查（仅对 staged 文件）
echo -e "\n${YELLOW}4️⃣ ESLint 检查...${NC}"
# 获取暂存的 TypeScript 文件
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

if [ -n "$STAGED_FILES" ]; then
  echo "检查文件："
  echo "$STAGED_FILES" | sed 's/^/  - /'

  if ! npx eslint $STAGED_FILES; then
    echo -e "${RED}❌ ESLint 检查失败${NC}"
    echo -e "${YELLOW}运行 'npm run lint:fix' 自动修复${NC}"
    exit 1
  fi
  echo -e "${GREEN}✅ ESLint 检查通过${NC}"
else
  echo -e "${YELLOW}⚠️  没有 TypeScript 文件被暂存${NC}"
fi

echo -e "\n${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${GREEN}✅ 所有检查通过！${NC}"
echo -e "${GREEN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
